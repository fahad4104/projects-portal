generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  RISK
  COMPLETED
}

enum Role {
  OWNER
  CONTRACTOR
  CONSULTANT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}


//
// ========== MODELS ==========
//

// مستخدم النظام (تسجيل الدخول)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime? @updatedAt

  // عضويته في المشاريع المختلفة
  projectMembers  ProjectMember[]

  // المهام التي أنشأها
  tasksCreated    Task[]           @relation("TaskCreatedBy")

  // المهام الموجهة له
  taskAssignments TaskAssignment[]
}

// المشروع نفسه
model Project {
  id              String         @id @default(cuid())
  code            String           // مثل P-001
  name            String

  ownerName       String
  contractorName  String
  consultantName  String?
  status          ProjectStatus  @default(IN_PROGRESS)

  // بريد الحساب (اختياري)
  accountEmail    String?

  // العلاقات
  tasks           Task[]
  drawings        Drawing[]
  photos          ProjectPhoto[]
  members         ProjectMember[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// علاقة بين المستخدم والمشروع (أي مستخدم يشتغل في مشروع)
model ProjectMember {
  id        String   @id @default(cuid())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // وصف الدور في المشروع (مالك المشروع، المقاول، الاستشاري...)
  roleLabel String?

  createdAt DateTime @default(now())
}

model Task {
  id        String      @id @default(cuid())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title     String
  status    TaskStatus  @default(PENDING)

  ownerRoleLabel   String?
  assignedToRoles  String?
  visibleToRoles   String?

  createdAt DateTime @default(now())
  completedAt DateTime?

  createdBy       User? @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?

  assignments TaskAssignment[]
}



// ربط مهمة مع مستخدم (ممكن يكون أكثر من مستخدم لنفس المهمة)
model TaskAssignment {
  id        String   @id @default(cuid())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // نص مثل "المالك"، "المقاول" لو حبيت تربطه بمسمى دوره في المشروع
  roleLabel String?

  createdAt DateTime @default(now())
}

// المخططات
model Drawing {
  id         String   @id @default(cuid())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  boxName    String          // اسم المربع (مخطط معماري، إنشائي...)
  fileName   String?
  filePath   String?
  uploadedBy String?
  uploadedAt DateTime?
  isArchived Boolean  @default(false)
}

// صور المشروع
model ProjectPhoto {
  id         String   @id @default(cuid())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
 uploadedBy String?
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())
}
